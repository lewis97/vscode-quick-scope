{
  "name": "vscode-quick-scope",
  "displayName": "Vim quick-scope",
  "description": "Highlights a unique character in each word so you can jump there with `f` and similar. Who needs EasyMotion?",
  "version": "0.1.3",
  "publisher": "skattyadz",
  "engines": {
    "vscode": "^1.19.0"
  },
  "categories": ["Other"],
  "keywords": ["vim", "quick-scope", "quick", "scope", "jump"],
  "activationEvents": ["*"],
  "main": "./out/extension",
  "contributes": {
    "configuration": {
      "title": "Quick Scope",
      "properties": {
        "vscode-quick-scope.highlightColor": {
          "type": "string",
          "default": "#ff9900",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "description": "Hex color for characters that can be targeted by the current Vim find motion."
        },
        "vscode-quick-scope.dimmedTextColor": {
          "type": "string",
          "default": "#808080",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "description": "Hex color for other text on the current line while jump highlights are shown."
        },
        "vscode-quick-scope.dimmedBackgroundColor": {
          "type": "string",
          "default": "#00000033",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "description": "Hex color for the translucent background over the current line while jump highlights are shown. An alpha channel is supported."
        }
      }
    },
    "commands": [
      {
        "command": "vscode-quick-scope.showForwardHighlights",
        "title": "Quick Scope: Show forward jump highlights"
      },
      {
        "command": "vscode-quick-scope.showReverseHighlights",
        "title": "Quick Scope: Show reverse jump highlights"
      },
      {
        "command": "vscode-quick-scope.hideHighlights",
        "title": "Quick Scope: Hide jump highlights"
      }
    ],
    "configurationDefaults": {
      "vim.normalModeKeyBindingsNonRecursive": [
        {
          "before": ["f"],
          "after": ["f"],
          "commands": ["vscode-quick-scope.showForwardHighlights"]
        },
        {
          "before": ["F"],
          "after": ["F"],
          "commands": ["vscode-quick-scope.showReverseHighlights"]
        },
        {
          "before": ["t"],
          "after": ["t"],
          "commands": ["vscode-quick-scope.showForwardHighlights"]
        },
        {
          "before": ["T"],
          "after": ["T"],
          "commands": ["vscode-quick-scope.showReverseHighlights"]
        },
        {
          "before": ["<Esc>"],
          "after": ["<Esc>"],
          "commands": ["vscode-quick-scope.hideHighlights"]
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./node_modules/vscode/bin/test"
  },
  "devDependencies": {
    "typescript": "^2.6.1",
    "vscode": "^1.1.6",
    "@types/node": "^7.0.43",
    "@types/mocha": "^2.2.42"
  }
}
